# ========================================================
# Kaldis Coffee Telegram Reply Tracker (v2)
# Environment Configuration
# ========================================================

APP_NAME="Kaldis Coffee - Telegram Reply Tracker"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://kaldisbunnaet.com/tgroup
APP_TIMEZONE=Africa/Addis_Ababa
APP_RETENTION_DAYS=180

# Database Configuration (cPanel MySQL / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kaldisbp_ict
DB_USER=kaldisbp_ictuser
DB_PASSWORD=YourDatabasePasswordHere

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=kaldis_tracker_bot
TELEGRAM_WEBHOOK_URL=https://kaldisbunnaet.com/tgroup/webhook
TELEGRAM_WEBHOOK_SECRET=KaldisSecureWebhookToken_2026

# Session Security (Set to true in production over HTTPS)
SESSION_SECURE=true
