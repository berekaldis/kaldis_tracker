# Kaldis Coffee Telegram Reply Tracker - .gitignore

# Storage logs & exports
storage/logs/*.log
storage/exports/*.csv
storage/exports/*.xlsx
!storage/logs/.gitkeep
!storage/exports/.gitkeep

# Environment & local overrides
.env
*.local.php

# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary test artifacts
cookies.txt
cookies_*.txt
*.tmp
